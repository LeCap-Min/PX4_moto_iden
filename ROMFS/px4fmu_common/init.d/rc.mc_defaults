#!/bin/sh
#
# Multicopter default parameters.
#
# NOTE: Script variables are declared/initialized/unset in the rcS script.
#

set VEHICLE_TYPE mc

# MAV_TYPE_QUADROTOR 2
param set-default MAV_TYPE 2

# 辨识固件：启用 control_allocator（fs_uart_servo 由 CA 按 IDEN_TYPE 启停）
param set-default SYS_CTRL_ALLOC 1

if param compare IMU_GYRO_RATEMAX 400
then
	param set-default IMU_GYRO_RATEMAX 800
fi

param set-default PWM_MAIN_MAX 1950
param set-default PWM_MAIN_MIN 1075
param set-default PWM_MAIN_RATE 400

# navigator 不启动，RTL_* 不会被 param_find；QGC 安全页会读取它们，
# 这里标记为已用以便 MAVLink 上报，避免 QGC 报"固件缺少参数"
param touch RTL_RETURN_ALT RTL_DESCEND_ALT RTL_LAND_DELAY

# control_allocator 模式：跳过传统 mixer 加载
set MIXER skip
set MIXER_AUX none

set PWM_OUT 1234

set PWM_AUX_OUT 1234
