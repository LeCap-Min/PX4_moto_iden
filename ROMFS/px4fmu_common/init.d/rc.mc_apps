#!/bin/sh
#
# 辨识固件：多旋翼应用（EKF2 姿态 + 手飞控制链 + control_allocator）
#
# NOTE: Script variables are declared/initialized/unset in the rcS script.
#

#
# EKF2 姿态估计（辨识固件固定使用，Servo_iden_data 的 roll/pitch 来自 vehicle_attitude）
#
param set-default SYS_MC_EST_GROUP 2
ekf2 start &

if param compare SYS_CTRL_ALLOC 1
then
	#
	# Start Control Allocator
	#
	control_allocator start
fi

#
# Start Multicopter Rate Controller.
#
mc_rate_control start

#
# Start Multicopter Attitude Controller.
#
mc_att_control start

#
# Start Multicopter Land Detector.
#
land_detector start multicopter
